# Cognito configuration (get these from cloud.core deploy output)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Products HTTP API base URL (from cloud.core deploy output / SSM api-config)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Force local mock mode for products (stores data in browser localStorage).
# When unset, mock mode auto-activates if VITE_API_URL is empty.
VITE_USE_MOCK=false

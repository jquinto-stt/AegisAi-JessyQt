# PayZen / Lyra REST API V4.0 — payment order integration
#
# PAYZEN_MODE controls the backend PayZen client:
#   mock  -> no real calls, returns a fabricated payment link (default, no subscription needed)
#   live  -> real authenticated POST to PayZen (requires the store vars below)
PAYZEN_MODE=mock

# ── Default store (serves the URL channel and any channel without an override) ──
# Obtain from the PayZen Back Office: Configuración > Tienda > "Claves de la API REST".
# NEVER commit real credentials. Keep them in .env (git-ignored), not here.
PAYZEN_USERNAME=
PAYZEN_PASSWORD=
# Full REST endpoint for your account, e.g. https://api.lyra.com/api-payment/V4
PAYZEN_ENDPOINT=

# ── WhatsApp store (optional — serves the WHATSAPP channel: native delivery) ──
# Only needed if a different shop/platform handles WhatsApp delivery. When set,
# WHATSAPP-channel orders route here instead of the default store.
# e.g. endpoint https://api.payzen.lat/api-payment/V4
PAYZEN_WA_USERNAME=
PAYZEN_WA_PASSWORD=
PAYZEN_WA_ENDPOINT=

# Port the microservice listens on locally
PORT=8080
